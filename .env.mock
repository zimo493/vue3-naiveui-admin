# 独立 mock 服务构建环境（pnpm build:mock → .deploy/mock-server）
#
# VITE_BASE_URL：部署基础路径，必须与 nginx 里的访问路径一致（本项目在 /naiveui/ 下）
VITE_BASE_URL=/naiveui/

# VITE_API_BASE：同时决定三件事，必须一致，否则 mock 不会被命中：
#   1. 前端请求前缀（axios baseURL）
#   2. mock 文件的 URL 前缀（mock/base.ts 拼出的完整路径）
#   3. mock 服务的拦截前缀（插件读取 server.proxy 的 key，路径不以它开头直接放行）
# 这里用 /naiveui-mock-api，与 vue3-element-template 的 /mock-api 区分开：
# 两个项目在同一台服务器上各有独立的 mock 容器（8082 / 8081），前缀不能相同。
VITE_API_BASE=/naiveui-mock-api

# 超时时间
VITE_APP_TIMEOUT=30000

# 应用端口（构建期不需要，仅与开发环境保持一致）
VITE_APP_PORT=5173

# 接口地址（仅开发代理转发用，构建独立 mock 服务时不生效）
VITE_PROXY_TARGET=https://www.youlai.tech

# WebSocket 端点（不配置则关闭）
VITE_APP_WS_ENDPOINT=

# 默认多语言 enUS | zhCN | zhTW（跟随生产构建；想要中文界面改成 zhCN）
VITE_DEFAULT_LANG='enUS'

# 本地存储前缀
VITE_STORAGE_PREFIX='store-'

# 开启 mock 插件
VITE_MOCK_ENABLED=true

# 产出独立 mock 服务：产物在 .deploy/mock-server
VITE_MOCK_BUILD=true

# 独立 mock 服务监听端口（template 用 8081，这里用 8082）
VITE_MOCK_PORT=8082
