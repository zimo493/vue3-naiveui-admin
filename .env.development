# 基础路径
VITE_BASE_URL=/

# 应用端口
VITE_APP_PORT=5173

# 代理前缀
VITE_API_BASE=/dev-api

# 超时时间
VITE_APP_TIMEOUT=6000

# 接口地址（开发代理转发目标；mock 未覆盖的接口才会走到这里）
VITE_PROXY_TARGET=https://api.youlai.tech
# VITE_PROXY_TARGET=http://localhost:8000

# Mock 开关
VITE_MOCK_ENABLED=true

# WebSocket 端点（不配置则关闭）本地 ws://localhost:8000/ws
VITE_APP_WS_ENDPOINT=

# 默认多语言 enUS | zhCN | zhTW
VITE_DEFAULT_LANG='zhCN'

# 本地存储前缀
VITE_STORAGE_PREFIX='store-'
